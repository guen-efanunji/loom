{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".svelte-kit/**", "build/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"db:push": {
			"cache": false,
			"interactive": true
		},
		"db:generate": {
			"cache": false,
			"interactive": true
		},
		"db:migrate": {
			"cache": false,
			"interactive": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:local": {
			"cache": false,
			"persistent": true
		}
	},
	"globalEnv": [
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"CI",
		"CORS_ORIGIN",
		"DATABASE_URL",
		"LOOM_VERSION",
		"NODE_ENV",
		"PUBLIC_SERVER_URL",
		"RELEASE_TAG",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_PROJECT_PRODUCTION_URL",
		"VERCEL_URL",
		"_VARLOCK_ENV_KEY"
	],
	"globalPassThroughEnv": [
		"CLOUDFLARE_ACCOUNT_ID",
		"CLOUDFLARE_API_TOKEN",
		"LOOM_CF_CREATE_ZONE",
		"LOOM_CF_FIX_DNS",
		"LOOM_CF_ALIASES",
		"LOOM_CHANNEL",
		"LOOM_DOMAIN",
		"LOOM_HOME",
		"LOOM_PORT",
		"LOOM_PAGES_BRANCH",
		"LOOM_PAGES_PROJECT",
		"LOOM_RELEASE_BASE",
		"LOOM_SITE_BASE",
		"NO_COLOR",
		"PUBLIC_INSTALL_BASE"
	],
	"globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
