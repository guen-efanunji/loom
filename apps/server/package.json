{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc -b ../../packages/api && tsdown",
		"check-types": "tsc -b ../../packages/api && tsc --noEmit",
		"test": "bun test",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "LOOM_PORT=${LOOM_PORT:-4318} LOOM_DAEMON=true bun run src/index.ts",
		"start": "bun run dist/index.mjs",
		"env:generate": "varlock codegen"
	},
	"dependencies": {
		"@loom/api": "workspace:*",
		"@loom/auth": "workspace:*",
		"@loom/db": "workspace:*",
		"@loom/distribution": "workspace:*",
		"@loom/opencode": "workspace:*",
		"@loom/orchestrator": "workspace:*",
		"@loom/protocol": "workspace:*",
		"@loom/providers": "workspace:*",
		"@loom/worktree": "workspace:*",
		"@modelcontextprotocol/client": "2.3.1",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"bun-pty": "^0.5.1",
		"hono": "^4.13.7",
		"libsql": "catalog:",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@loom/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	}
}
