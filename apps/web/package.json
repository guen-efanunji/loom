{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "tsc -b ../../packages/api && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check-types": "tsc -b ../../packages/api && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "tsc -b ../../packages/protocol ../../packages/api && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"env:generate": "varlock codegen"
	},
	"dependencies": {
		"@loom/api": "workspace:*",
		"@loom/protocol": "workspace:*",
		"@orpc/client": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/tanstack-query": "^1.15.0",
		"@tanstack/svelte-form": "^1.33.5",
		"@tanstack/svelte-query": "^6.1.48",
		"@varlock/vite-integration": "1.5.1",
		"better-auth": "catalog:",
		"dompurify": "^3.4.15",
		"highlight.js": "^11.12.0",
		"marked": "^18.0.12",
		"svelte-sonner": "^1.2.1",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@loom/config": "workspace:*",
		"@lucide/svelte": "^1.45.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-query-devtools": "^6.1.48",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vite": "^8.2.2"
	}
}
