{
	"name": "@loom/providers",
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./src/index.ts"
		},
		"./core": {
			"types": "./dist/src/core/index.d.ts",
			"default": "./src/core/index.ts"
		},
		"./*": {
			"types": "./dist/src/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"check-types": "tsc -b",
		"test": "bun test"
	},
	"dependencies": {
		"@loom/opencode": "workspace:*"
	},
	"devDependencies": {
		"@loom/config": "workspace:*",
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
