{
	"name": "@loom/db",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./dist/src/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"check-types": "tsc -b",
		"db:local": "turso dev --db-file local.db",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate:deploy": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"test": "bun test"
	},
	"dependencies": {
		"@libsql/client": "0.18.0",
		"drizzle-orm": "^0.45.2",
		"libsql": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@loom/config": "workspace:*",
		"drizzle-kit": "^0.31.10",
		"typescript": "catalog:",
		"varlock": "catalog:"
	}
}
